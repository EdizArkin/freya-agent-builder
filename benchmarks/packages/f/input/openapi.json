{
 "openapi": "3.0.3",
 "info": {
  "title": "Calder Savings Bank arrears tools",
  "version": "1.0",
  "description": "The service records what it is sent. It does not enforce the bank's rules: following them is the agent's job."
 },
 "servers": [
  {
   "url": "https://tools.calder-savings.example/v2"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Three wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         },
         "question": {
          "type": "string",
          "enum": [
           "birth_date",
           "account_last3"
          ]
         },
         "given_answer": {
          "type": "string",
          "description": "For birth_date: the date as YYYY-MM-DD. For account_last3: three digits."
         }
        },
        "required": [
         "case_id",
         "question",
         "given_answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "match": {
           "type": "boolean"
          },
          "tries_left": {
           "type": "integer"
          },
          "all_passed": {
           "type": "boolean"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The overdue accounts. Refused until both questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         }
        },
        "required": [
         "case_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "accounts": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "account_ref": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "overdraft",
               "card",
               "loan"
              ]
             },
             "card_tail": {
              "type": "string",
              "description": "cards only"
             },
             "overdue_amount": {
              "type": "number"
             },
             "days_overdue": {
              "type": "integer"
             },
             "instalment": {
              "type": "number",
              "description": "loans only"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per account.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         },
         "account_ref": {
          "type": "string"
         },
         "pay_amount": {
          "type": "number"
         },
         "pay_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "case_id",
         "account_ref",
         "pay_amount",
         "pay_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_ref": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why an account ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         },
         "account_ref": {
          "type": "string"
         },
         "note_code": {
          "type": "string",
          "enum": [
           "declined",
           "contested",
           "settled",
           "hardship",
           "system_fault"
          ]
         }
        },
        "required": [
         "case_id",
         "account_ref",
         "note_code"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         },
         "callback_date": {
          "type": "string",
          "format": "date"
         },
         "callback_time": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "case_id",
         "callback_date",
         "callback_time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a team.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         },
         "team": {
          "type": "string",
          "enum": [
           "hardship_desk",
           "payment_plans",
           "agent"
          ]
         }
        },
        "required": [
         "case_id",
         "team"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "case_id": {
          "type": "string",
          "description": "The case this call belongs to. It is the secret of one call."
         },
         "result": {
          "type": "string",
          "enum": [
           "agreed",
           "settled",
           "handed_over",
           "no_agreement",
           "unverified",
           "no_contact"
          ]
         },
         "reason_code": {
          "type": "string",
          "description": "See the code list. Left out where the code list says none."
         }
        },
        "required": [
         "case_id",
         "result"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`success` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}
